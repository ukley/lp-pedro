---
import "../styles/global.css";

// Prefixa arquivos de /public com o base path (GitHub Pages serve em /lp-pedro/)
const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${p}`;

// WhatsApp: DDI + DDD + número, só dígitos
const WHATSAPP = "5567998678291";
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
const ctaMsg = "Olá! Gostaria de solicitar um orçamento de pintura.";

const testimonials = [
  { name: "Carlos M.", role: "Síndico de condomínio", text: "Contratei para a pintura externa do nosso condomínio e o resultado foi impecável. Equipe muito organizada e pontual!" },
  { name: "Juliana S.", role: "Proprietária de residência", text: "Reformaram toda a pintura interna da minha casa em Campo Grande. Trabalho limpo, caprichoso e acabamento perfeito nas paredes." },
  { name: "Roberto A.", role: "Empresário", text: "Profissionais de altíssimo nível. Cumpriram o prazo à risca e o preço foi justo pelo nível de qualidade entregue." },
];

const services = [
  {
    title: "Pintura Interna",
    icon: "M3 10.5 12 3l9 7.5V21H3z",
    items: ["Preparação e correção de paredes", "Acabamento liso e uniforme", "Proteção total de móveis e pisos"],
  },
  {
    title: "Fachadas",
    icon: "M4 21V5l8-3 8 3v16M9 21v-6h6v6",
    items: ["Impermeabilização e textura", "Tintas resistentes a sol e chuva", "Pintura predial e condomínios"],
  },
  {
    title: "Efeitos Decorativos",
    icon: "M12 3v4m0 10v4M3 12h4m10 0h4M6 6l2.5 2.5m7 7L18 18M18 6l-2.5 2.5m-7 7L6 18",
    items: ["Textura, grafiato e cimento queimado", "Efeitos metálicos e degradê", "Consultoria de cores inclusa"],
  },
];

const trust = [
  { t: "Proteção total dos móveis", icon: "M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" },
  { t: "Limpeza pós-obra", icon: "M5 21h14M8 21l1-9h6l1 9M10 12V4h4v8" },
  { t: "Orçamento sem surpresas", icon: "M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" },
  { t: "Pintores verificados", icon: "M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0zM4 21c0-4 4-6 8-6s8 2 8 6" },
];

const faqs = [
  { q: "Vocês fornecem a tinta ou eu preciso comprar?", a: "Podemos fornecer o orçamento completo com materiais de melhor custo-benefício ou trabalhar com os materiais adquiridos por você." },
  { q: "A visita técnica para orçamento é paga?", a: "Não. A visita e a medição no local em Campo Grande são gratuitas e sem compromisso." },
  { q: "Quanto tempo leva para pintar uma casa ou apartamento?", a: "Depende do tamanho do imóvel. Dimensionamos a equipe para entregar no menor prazo possível, sem perder qualidade." },
  { q: "Como fica a limpeza após o término da pintura?", a: "Protegemos pisos e móveis antes de começar e entregamos o ambiente limpo e organizado." },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Pintura residencial e predial em Campo Grande - MS. Equipe própria, garantia, pontualidade e visita técnica gratuita. Peça seu orçamento pelo WhatsApp." />
    <title>Pintura Residencial e Predial em Campo Grande - MS | Orçamento Grátis</title>
  </head>
  <body class="bg-stone-50 text-stone-600 antialiased">
    <!-- Hero -->
    <header class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-teal-700">Pintura residencial e predial · Campo Grande - MS</p>
          <h1 class="text-4xl font-bold tracking-tight text-stone-900 lg:text-5xl">
            Renove seu imóvel com acabamento perfeito e zero dor de cabeça
          </h1>
          <p class="mt-6 text-lg">Equipe própria, orçamento transparente e limpeza garantida. Visita técnica gratuita, sem taxa de deslocamento.</p>
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <a href={wa(ctaMsg)} class="rounded-xl bg-teal-700 px-8 py-4 font-semibold text-white shadow-lg transition-colors hover:bg-teal-800">
              Solicitar orçamento grátis
            </a>
            <p class="text-sm font-medium text-stone-900"><span class="text-amber-500">★</span> 4.9 em mais de 300 casas pintadas</p>
          </div>
        </div>
        <div class="media-frame relative mx-auto w-full max-w-md overflow-hidden rounded-2xl shadow-xl ring-1 ring-stone-900/10">
          <img
            src={asset("hero-pintura.svg")}
            alt="Ilustração de parede sendo pintada com rolo, piso protegido por lona e lata de tinta"
            width="800"
            height="1000"
            class="media-enhance aspect-[4/5] w-full object-cover"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-stone-900/30 via-transparent to-white/10"></div>
        </div>
      </div>
    </header>

    <!-- Provas sociais -->
    <section class="bg-white py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-3xl font-bold tracking-tight text-stone-900">O que dizem nossos clientes</h2>
        <p class="mt-3">Confiado por síndicos, engenheiros e proprietários exigentes em Campo Grande.</p>
        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl border border-stone-200 bg-stone-50 p-8">
              <p class="text-amber-500" aria-label="5 estrelas">★★★★★</p>
              <blockquote class="mt-4 flex-1 text-stone-700">“{t.text}”</blockquote>
              <figcaption class="mt-6">
                <p class="font-semibold text-stone-900">{t.name}</p>
                <p class="text-sm">{t.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Serviços -->
    <section class="py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-3xl font-bold tracking-tight text-stone-900">Nossos serviços</h2>
        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {services.map((s) => (
            <div class="rounded-2xl border border-stone-200 bg-white p-8 transition-colors hover:border-teal-600">
              <svg class="h-10 w-10 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
              <h3 class="mt-4 text-xl font-semibold text-stone-900">{s.title}</h3>
              <ul class="mt-4 space-y-2">
                {s.items.map((it) => (
                  <li class="flex gap-2"><span class="text-teal-600">✔</span>{it}</li>
                ))}
              </ul>
              <a href={wa(`Olá! Quero um orçamento de ${s.title}.`)} class="mt-6 inline-block font-semibold text-teal-700 hover:text-teal-800">Pedir orçamento →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Trabalhos -->
    <section class="py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-3xl font-bold tracking-tight text-stone-900">Nossos trabalhos</h2>
        <p class="mt-3">Veja de perto o acabamento entregue pela nossa equipe.</p>
        <div class="mt-10 grid grid-cols-1 items-start gap-8 md:grid-cols-2">
          <div class="media-frame mx-auto w-full max-w-sm overflow-hidden rounded-2xl bg-stone-200 shadow-xl ring-1 ring-stone-900/10">
            <video
              src={asset("obra-video.mp4")}
              controls
              muted
              playsinline
              preload="metadata"
              poster={asset("obra-1.jpg")}
              class="media-enhance aspect-[9/16] w-full object-cover"
            ></video>
          </div>
          <div class="media-frame relative mx-auto w-full max-w-sm overflow-hidden rounded-2xl shadow-xl ring-1 ring-stone-900/10">
            <img
              src={asset("obra-1.jpg")}
              alt="Detalhe de acabamento de pintura"
              width="899"
              height="1599"
              loading="lazy"
              class="media-enhance aspect-[9/16] w-full object-cover"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-stone-900/30 via-transparent to-white/10"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Garantias -->
    <section class="bg-stone-100 py-12">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 md:grid-cols-4">
        {trust.map((t) => (
          <div class="flex flex-col items-center text-center">
            <svg class="h-9 w-9 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
            <p class="mt-3 font-semibold text-stone-900">{t.t}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="text-3xl font-bold tracking-tight text-stone-900">Tire suas dúvidas</h2>
        <div class="mt-8 divide-y divide-stone-200">
          {faqs.map((f) => (
            <details class="py-4">
              <summary class="cursor-pointer font-semibold text-stone-900">{f.q}</summary>
              <p class="mt-2">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Formulário -->
    <section id="orcamento" class="px-6 pb-20">
      <div class="mx-auto max-w-4xl rounded-3xl bg-teal-900 p-8 text-white lg:p-12">
        <h2 class="text-3xl font-bold tracking-tight">Orçamento rápido</h2>
        <p class="mt-2 text-teal-100">Três informações e retornamos pelo WhatsApp.</p>
        <form id="lead" class="mt-8 space-y-6">
          <fieldset>
            <legend class="mb-2 font-semibold">Tipo de imóvel</legend>
            <div class="flex gap-3" data-group="tipo">
              <button type="button" data-v="Casa" class="opt rounded-lg border border-teal-600 px-5 py-3 font-medium">Casa</button>
              <button type="button" data-v="Apartamento" class="opt rounded-lg border border-teal-600 px-5 py-3 font-medium">Apto</button>
            </div>
          </fieldset>
          <fieldset>
            <legend class="mb-2 font-semibold">Metragem aproximada</legend>
            <div class="flex flex-wrap gap-3" data-group="area">
              {["Até 50 m²", "50 a 100 m²", "100 a 200 m²", "Mais de 200 m²"].map((a) => (
                <button type="button" data-v={a} class="opt rounded-lg border border-teal-600 px-5 py-3 font-medium">{a}</button>
              ))}
            </div>
          </fieldset>
          <div>
            <label for="whats" class="mb-2 block font-semibold">Seu WhatsApp</label>
            <input id="whats" type="tel" required placeholder="(67) 99999-9999" class="w-full rounded-lg bg-white px-4 py-3 text-stone-900" />
          </div>
          <button type="submit" class="rounded-xl bg-white px-8 py-4 font-semibold text-teal-900 shadow-lg transition-colors hover:bg-teal-50">
            Receber orçamento
          </button>
        </form>
      </div>
    </section>

    <footer class="py-6 text-center text-sm text-stone-500">
      © {new Date().getFullYear()} Pintura Residencial e Predial · Campo Grande - MS
    </footer>

    <a href={wa(ctaMsg)} aria-label="Falar no WhatsApp" class="fixed bottom-4 right-4 z-10 rounded-full bg-teal-700 px-5 py-3 font-semibold text-white shadow-lg hover:bg-teal-800">WhatsApp</a>

    <script is:inline define:vars={{ WHATSAPP }}>
      // Formulário
      const sel = { tipo: "", area: "" };
      document.querySelectorAll("[data-group]").forEach((g) => {
        const key = g.dataset.group;
        g.querySelectorAll(".opt").forEach((o) => o.addEventListener("click", () => {
          g.querySelectorAll(".opt").forEach((x) => x.classList.remove("bg-white", "text-teal-900"));
          o.classList.add("bg-white", "text-teal-900");
          sel[key] = o.dataset.v;
        }));
      });
      document.getElementById("lead").addEventListener("submit", (e) => {
        e.preventDefault();
        const phone = document.getElementById("whats").value;
        const msg = `Olá! Quero um orçamento de pintura.\nImóvel: ${sel.tipo || "não informado"}\nMetragem: ${sel.area || "não informada"}\nMeu WhatsApp: ${phone}`;
        window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`, "_blank");
      });
    </script>
  </body>
</html>
